#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    macros {
        lng_swapper: lng_swapper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT_SHIFT)>;
            label = "LNG_SWAPPER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
&kp Q       &kp W       &kp E        &kp R        &kp T      &kp Y      &kp U        &kp I         &kp O          &kp P
&mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G      &kp H      &mt LSHFT J  &mt LCTRL K   &mt LALT L     &mt LGUI SEMICOLON
&kp Z       &kp X       &kp C        &kp V        &kp B      &kp N      &kp M        &kp COMMA     &kp DOT        &kp SLASH
                                     &kp DELETE   &lt 2 TAB  &kp SPACE  &kp ENTER    &lt 1 ESCAPE  &kp BACKSPACE
            >;
        };

        num_layer {
            bindings = <
&kp PERCENT    &kp HASH      &kp DOLLAR       &kp CARET      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS
&kp BACKSLASH  &kp AT_SIGN   &kp EXCLAMATION  &kp AMPERSAND  &kp LEFT_BRACKET      &kp RBKT               &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0
&kp SLASH      &kp ASTERISK  &kp PLUS         &kp EQUAL      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp UNDERSCORE
                                              &trans         &trans                &trans                 &trans        &trans        &trans
            >;
        };

        fn_layer {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2   &kp F3   &kp F4   &trans  &kp HOME        &kp UP_ARROW      &kp END          &lng_swapper
&kp GRAVE   &kp F5  &kp F6   &kp F7   &kp F8   &trans  &kp LEFT_ARROW  &kp DOWN_ARROW    &kp RIGHT_ARROW  &kp PRINTSCREEN
&kp TAB     &kp F9  &kp F10  &kp F11  &kp F12  &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT       &trans
                             &trans   &trans   &trans  &trans          &trans            &trans
            >;
        };
    };
};
